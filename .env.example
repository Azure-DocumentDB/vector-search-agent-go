# REFERENCE ONLY: binaries read process environment, never implicitly load .env.
# Export reviewed values with your shell/secret manager; do not commit credentials.
AZURE_DOCUMENTDB_AUTH_MODE=entra
AZURE_DOCUMENTDB_HOST=<cluster>.global.mongocluster.cosmos.azure.com
# Native alternative: AZURE_DOCUMENTDB_AUTH_MODE=native
# AZURE_DOCUMENTDB_CONNECTION_STRING=mongodb+srv://<username>:<percent-encoded-password>@<same-host>/?tls=true&retryWrites=false
# Optional registered Entra principal name:
# AZURE_DOCUMENTDB_OIDC_USERNAME=<principal>
AZURE_DOCUMENTDB_DATABASENAME=agent_go_disposable_example
AZURE_DOCUMENTDB_COLLECTION=agent_hotels
AGENT_DISPOSABLE_TARGET=agent_go_disposable_example.agent_hotels
AGENT_ALLOW_WRITES=false
# Separate explicit consent for cleanup; removes tagged rows only, never drops resources:
# AGENT_CONFIRM_CLEANUP=agent_go_disposable_example.agent_hotels

AZURE_OPENAI_AUTH_MODE=entra
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# Key alternative: AZURE_OPENAI_AUTH_MODE=key; supply only in secret environment:
# AZURE_OPENAI_API_KEY=<secret>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=agent-embedding
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21
AZURE_OPENAI_PLANNER_DEPLOYMENT=agent-planner
AZURE_OPENAI_PLANNER_API_VERSION=2024-10-21
AZURE_OPENAI_SYNTH_DEPLOYMENT=agent-synthesizer
AZURE_OPENAI_SYNTH_API_VERSION=2024-10-21
AGENT_ALLOW_PAID_INFERENCE=false
AGENT_MAX_MODEL_CALLS=53
AGENT_TIMEOUT=5m
EMBEDDING_DIMENSIONS=1536
VECTOR_INDEX_ALGORITHM=vector-ivf
DATA_FILE_WITHOUT_VECTORS=data/Hotels.json
QUERY=quiet hotel near running trails and restaurants
NEAREST_NEIGHBORS=3
