# Replace every <placeholder> before running. No secrets or real resources belong in Git.
# Set USE_PASSWORDLESS=true for Azure Identity, or false to use the API key / connection string lines.
USE_PASSWORDLESS=true

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<only-when-USE_PASSWORDLESS-is-false>
AZURE_OPENAI_PLANNER_DEPLOYMENT=<planner-deployment-name>
AZURE_OPENAI_PLANNER_API_VERSION=2024-08-01-preview
AZURE_OPENAI_SYNTH_DEPLOYMENT=<synthesizer-deployment-name>
AZURE_OPENAI_SYNTH_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>
AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15

# Azure DocumentDB
AZURE_DOCUMENTDB_CLUSTER=<your-cluster-name>
# AZURE_DOCUMENTDB_CONNECTION_STRING=<only-when-USE_PASSWORDLESS-is-false>
AZURE_DOCUMENTDB_DATABASENAME=Hotels
AZURE_DOCUMENTDB_COLLECTION=hotel_data
AZURE_DOCUMENTDB_INDEX_NAME=vectorIndex

# Data
DATA_FILE_WITHOUT_VECTORS=data/Hotels.json

# Vector index
VECTOR_INDEX_ALGORITHM=vector-ivf
EMBEDDING_DIMENSIONS=1536
NEAREST_NEIGHBORS=5
QUERY=quintessential lodging near running trails, eateries, retail
